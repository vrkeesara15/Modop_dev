# Copy to .env and adjust. Every setting is an environment variable (nothing is hard-coded).

# --- Database (Railway injects DATABASE_URL automatically when you add Postgres) ---
DATABASE_URL=postgresql://rah:rah@db:5432/rah

# --- Demo data: true seeds 60 people, 20 projects and 12 weeks on first start (empty DB only) ---
SEED_DEMO=true
DEMO_PASSWORD=demo1234
# First Admin for a real (non-demo) deploy; created only when the users table is empty
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Web ---
PORT=8000
APP_BASE_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_TTL_HOURS=12
COOKIE_SECURE=false

# --- Auth: local (email + password) or oidc (Microsoft Entra ID) ---
AUTH_MODE=local
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback

# --- File storage for raw OpenAir exports: local volume or S3-compatible ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# --- Scheduled import (IMP-5/6) ---
SCHEDULER_ENABLED=true
IMPORT_CRON=0 6 * * *
IMPORT_TIMEZONE=America/Chicago
# Drop daily exports here (or into <storage>/inbox/) for the scheduled pull
IMPORT_WATCH_DIR=/data/watch
# Optional OpenAir REST pull (confirm endpoint with your OpenAir admin)
OPENAIR_BASE_URL=
OPENAIR_CLIENT_ID=
OPENAIR_CLIENT_SECRET=
OPENAIR_REFRESH_TOKEN=
OPENAIR_REPORT_ID=

# --- Notifications: daily digest by email and/or Teams ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=resource-hub@example.com
TEAMS_WEBHOOK_URL=
